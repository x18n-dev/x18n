{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  // tsnapi writes these API snapshots; they are compared, never imported.
  "ignore": ["test/__snapshots__/tsnapi/**", "test/fixtures/**", "playground/**"],
  "ignoreDependencies": ["@antfu/utils", "taze", "@antfu/skills"],
  "workspaces": {
    ".": {
      // Loaded by the x18n CLI itself, not imported.
      "entry": ["x18n.config.ts"]
    },
    "packages/ui": {
      // `@unocss/reset` is loaded through the `css` option of `nuxt.config.ts`;
      // `vue-tsc` is run by `nuxt typecheck`; `@iconify-json/ph` is read by
      // `presetIcons` for `i-ph-*` classes. None is imported.
      "ignoreDependencies": ["@unocss/reset", "vue-tsc", "@iconify-json/ph"]
    }
  }
}
