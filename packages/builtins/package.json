{
  "name": "@x18n/builtins",
  "type": "module",
  "version": "0.0.13",
  "description": "Built-in x18n plugins and presets: formats, locale finders, scanners, checks and reporters",
  "author": "Anthony Fu <anthonyfu117@hotmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/x18n-dev/x18n#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/x18n-dev/x18n.git",
    "directory": "packages/builtins"
  },
  "bugs": "https://github.com/x18n-dev/x18n/issues",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./checks": "./dist/checks.mjs",
    "./extractors": "./dist/extractors.mjs",
    "./finders": "./dist/finders.mjs",
    "./formats": "./dist/formats.mjs",
    "./manifests": "./dist/manifests.mjs",
    "./placeholders": "./dist/placeholders.mjs",
    "./presets": "./dist/presets.mjs",
    "./reporters": "./dist/reporters.mjs",
    "./scanners": "./dist/scanners.mjs",
    "./yaml-plugin": "./dist/yaml-plugin.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "THIRD-PARTY-NOTICES.md",
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm build && cp ../../THIRD-PARTY-NOTICES.md ."
  },
  "dependencies": {
    "@vue/compiler-sfc": "catalog:deps",
    "@x18n/core": "workspace:*",
    "json5": "catalog:deps",
    "jsonc-parser": "catalog:deps",
    "oxc-parser": "catalog:deps",
    "svelte": "catalog:deps",
    "yaml": "catalog:deps"
  },
  "devDependencies": {
    "@vue/compiler-core": "catalog:deps"
  }
}
