{
  "name": "@x18n/cli",
  "type": "module",
  "version": "0.0.7",
  "description": "Manage and view i18n files of any project, for humans and agents",
  "author": "Anthony Fu <anthonyfu117@hotmail.com>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/antfu",
  "homepage": "https://github.com/x18n-dev/x18n#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/x18n-dev/x18n.git",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/x18n-dev/x18n/issues",
  "keywords": [
    "i18n",
    "cli",
    "locale",
    "translation"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./presets": "./dist/presets.mjs",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "bin": {
    "x18n": "./bin.mjs"
  },
  "files": [
    "bin.mjs",
    "dist",
    "skills"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@x18n/builtins": "workspace:*",
    "@x18n/core": "workspace:*",
    "@x18n/node": "workspace:*",
    "@x18n/ui": "workspace:*",
    "cac": "catalog:deps",
    "devframe": "catalog:deps",
    "nostics": "catalog:deps",
    "yaml": "catalog:deps"
  }
}
