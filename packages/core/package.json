{
  "name": "@x18n/core",
  "type": "module",
  "version": "0.1.4",
  "description": "Runtime-neutral engine of x18n: domain model, plugin API and project analysis",
  "author": "Anthony Fu <anthonyfu117@hotmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/x18n-dev/x18n#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/x18n-dev/x18n.git",
    "directory": "packages/core"
  },
  "bugs": "https://github.com/x18n-dev/x18n/issues",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json",
    "./schema/config.json": "./schema/config.json",
    "./schema/plugin.json": "./schema/plugin.json"
  },
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "schema"
  ],
  "scripts": {
    "build": "tsx scripts/schema.ts && tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "nostics": "catalog:deps",
    "valibot": "catalog:deps"
  },
  "devDependencies": {
    "@valibot/to-json-schema": "catalog:deps",
    "tsx": "catalog:cli"
  }
}
