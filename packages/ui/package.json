{
  "name": "@x18n/ui",
  "type": "module",
  "version": "0.0.2",
  "description": "x18n UI as a devframe: dev server, static report, in-browser workspace and VS Code panel",
  "author": "Anthony Fu <anthonyfu117@hotmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/antfu/x18n#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antfu/x18n.git",
    "directory": "packages/ui"
  },
  "bugs": "https://github.com/antfu/x18n/issues",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "nuxt build && tsdown",
    "dev": "nuxt dev --host",
    "codegen": "nuxt prepare",
    "typecheck": "nuxt typecheck && tsc -p tsconfig.node.json",
    "test:e2e": "playwright test",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@devframes/agentic": "catalog:deps",
    "@valibot/to-json-schema": "catalog:deps",
    "@x18n/builtins": "workspace:*",
    "@x18n/core": "workspace:*",
    "devframe": "catalog:deps",
    "valibot": "catalog:deps"
  },
  "devDependencies": {
    "@antfu/design": "catalog:frontend",
    "@iconify-json/ph": "catalog:frontend",
    "@playwright/test": "catalog:testing",
    "@unocss/nuxt": "catalog:frontend",
    "@unocss/reset": "catalog:frontend",
    "@vueuse/core": "catalog:frontend",
    "@x18n/node": "workspace:*",
    "colorjs.io": "catalog:frontend",
    "nuxt": "catalog:build",
    "unocss": "catalog:frontend",
    "vue-tsc": "catalog:build"
  }
}
