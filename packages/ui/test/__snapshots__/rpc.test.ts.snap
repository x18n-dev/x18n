[
  {
    "description": "Overview of the i18n project: locales with translation coverage, counts of keys, resources and usages, diagnostics by check, and detected presets. Call it first to learn project names, the source locale and locale codes.",
    "id": "x18n:status",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "properties": {
        "project": {
          "description": "Project name from \`x18n_status\`. Required only in a monorepo with several projects.",
          "type": "string",
        },
      },
      "required": [],
      "type": "object",
    },
    "safety": "read",
  },
  {
    "description": "List message keys, paged. Filter by \`missing\` locale (keys to translate), \`unused\` (keys no code uses), \`namespace\` or a key \`glob\`. Pass \`values: true\` to get the value per locale. Continue with \`cursor: nextCursor\`.",
    "id": "x18n:keys",
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "properties": {
        "cursor": {
          "description": "\`nextCursor\` of the previous page.",
          "type": "string",
        },
        "glob": {
          "description": "Key glob: \`*\` inside a segment, \`**\` across segments.",
          "type": "string",
        },
