        },
        "missing": {
          "description": "Only keys missing or empty in this locale.",
          "type": "string",
        },
        "namespace": {
          "type": "string",
        },
        "project": {
          "description": "Project name from \`x18n_status\`. Required only in a monorepo with several projects.",
          "type": "string",
        },
        "unused": {
