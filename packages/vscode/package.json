{
  "publisher": "antfu",
  "name": "x18n-vscode",
  "displayName": "x18n",
  "type": "module",
  "version": "0.0.14",
  "private": true,
  "description": "Manage and view i18n files of any project, for humans and agents",
  "author": "Anthony Fu <anthonyfu117@hotmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/x18n-dev/x18n#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/x18n-dev/x18n.git",
    "directory": "packages/vscode"
  },
  "bugs": "https://github.com/x18n-dev/x18n/issues",
  "keywords": [
    "i18n",
    "l10n",
    "translation",
    "vue-i18n",
    "i18next"
  ],
  "categories": [
    "Other",
    "Linters"
  ],
  "main": "./dist/index.cjs",
  "icon": "res/icon.png",
  "files": [
    "LICENSE.md",
    "README.md",
    "dist/*",
    "res/*"
  ],
  "engines": {
    "vscode": "^1.100.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "x18n.findKeyByText",
        "title": "Find Key by Text",
        "category": "x18n",
        "icon": "$(search)"
      },
      {
        "command": "x18n.openUi",
        "title": "Open UI",
        "category": "x18n",
        "icon": "$(window)"
      },
      {
        "command": "x18n.openKey",
        "title": "Open Key in UI",
        "category": "x18n",
        "icon": "$(link-external)"
      },
      {
        "command": "x18n.setDisplayLocale",
        "title": "Set Display Locale",
        "category": "x18n",
        "icon": "$(globe)"
      },
      {
        "command": "x18n.editKey",
        "title": "Edit Message",
        "category": "x18n",
        "icon": "$(edit)"
      },
      {
        "command": "x18n.renameKeyPrefix",
        "title": "Rename Key Prefix",
        "category": "x18n"
      },
      {
        "command": "x18n.deleteKey",
        "title": "Delete Key",
        "category": "x18n",
        "icon": "$(trash)"
      },
      {
        "command": "x18n.extract",
        "title": "Extract Hard String",
        "category": "x18n"
      },
      {
        "command": "x18n.extractFile",
        "title": "Extract All Hard Strings in File",
        "category": "x18n"
      },
      {
        "command": "x18n.copyTranslatePrompt",
        "title": "Copy Translate Prompt",
        "category": "x18n",
        "icon": "$(copy)"
      },
      {
        "command": "x18n.translateWithAgent",
        "title": "Translate with Agent",
        "category": "x18n",
        "icon": "$(sparkle)"
      },
      {
        "command": "x18n.goToNextUsage",
        "title": "Go to Next Key Usage",
        "category": "x18n"
      },
      {
        "command": "x18n.goToPrevUsage",
        "title": "Go to Previous Key Usage",
        "category": "x18n"
      },
      {
        "command": "x18n.toggleInPlace",
        "title": "Toggle In-place Annotations",
        "category": "x18n",
        "icon": "$(eye)"
      },
      {
        "command": "x18n.restartServer",
        "title": "Restart Language Server",
        "category": "x18n"
      },
      {
        "command": "x18n.migrateFromI18nAlly",
        "title": "Migrate from i18n-ally",
        "category": "x18n"
      },
      {
        "command": "x18n.showOutput",
        "title": "Show Output",
        "category": "x18n"
      },
      {
        "command": "x18n.explainProjects",
        "title": "Explain Projects",
        "category": "x18n"
      },
      {
        "command": "x18n.addReview",
        "title": "Review Key",
        "category": "x18n",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "x18n.replyReview",
        "title": "Comment",
        "category": "x18n"
      },
      {
        "command": "x18n.approveReview",
        "title": "Approve",
        "category": "x18n"
      },
      {
        "command": "x18n.requestReviewChange",
        "title": "Request Change",
        "category": "x18n"
      },
      {
        "command": "x18n.suggestReview",
        "title": "Suggest as Value",
        "category": "x18n"
      },
      {
        "command": "x18n.resolveReviewComment",
        "title": "Resolve",
        "category": "x18n",
        "icon": "$(check)"
      },
      {
        "command": "x18n.applyReviewSuggestion",
        "title": "Apply Suggestion",
        "category": "x18n",
        "icon": "$(lightbulb-autofix)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "x18n.renameKeyPrefix",
          "when": "false"
        },
        {
          "command": "x18n.replyReview",
          "when": "false"
        },
        {
          "command": "x18n.approveReview",
          "when": "false"
        },
        {
          "command": "x18n.requestReviewChange",
          "when": "false"
        },
        {
          "command": "x18n.suggestReview",
          "when": "false"
        },
        {
          "command": "x18n.resolveReviewComment",
          "when": "false"
        },
        {
          "command": "x18n.applyReviewSuggestion",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "x18n.findKeyByText",
          "when": "view == x18n.keys",
          "group": "navigation"
        },
        {
          "command": "x18n.openUi",
          "when": "view =~ /^x18n\\./",
          "group": "navigation"
        },
        {
          "command": "x18n.setDisplayLocale",
          "when": "view =~ /^x18n\\./",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "x18n.editKey",
          "when": "viewItem == x18n.key",
          "group": "inline"
        },
        {
          "command": "x18n.openKey",
          "when": "viewItem == x18n.key",
          "group": "inline"
        },
        {
          "command": "x18n.copyTranslatePrompt",
          "when": "viewItem == x18n.key"
        },
        {
          "command": "x18n.translateWithAgent",
          "when": "viewItem == x18n.key"
        },
        {
          "command": "x18n.deleteKey",
          "when": "viewItem == x18n.key"
        },
        {
          "command": "x18n.renameKeyPrefix",
          "when": "viewItem == x18n.prefix"
        },
        {
          "command": "x18n.addReview",
          "when": "viewItem == x18n.key"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "x18n.replyReview",
          "when": "commentController == x18n.reviews",
          "group": "inline@1"
        },
        {
          "command": "x18n.suggestReview",
          "when": "commentController == x18n.reviews",
          "group": "inline@2"
        },
        {
          "command": "x18n.requestReviewChange",
          "when": "commentController == x18n.reviews",
          "group": "inline@3"
        },
        {
          "command": "x18n.approveReview",
          "when": "commentController == x18n.reviews",
          "group": "inline@4"
        }
      ],
      "comments/comment/title": [
        {
          "command": "x18n.applyReviewSuggestion",
          "when": "commentController == x18n.reviews && comment =~ /^x18n\\.review\\.suggestion\\.open$/",
          "group": "inline"
        },
        {
          "command": "x18n.resolveReviewComment",
          "when": "commentController == x18n.reviews && comment =~ /\\.open$/",
          "group": "inline"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "x18n",
          "title": "x18n",
          "icon": "res/activitybar.svg"
        }
      ]
    },
    "views": {
      "x18n": [
        {
          "id": "x18n.currentFile",
          "name": "Current File"
        },
        {
          "id": "x18n.progress",
          "name": "Progress"
        },
        {
          "id": "x18n.keys",
          "name": "Keys"
        },
        {
          "id": "x18n.usageReport",
          "name": "Usage Report"
        },
        {
          "id": "x18n.reviews",
          "name": "Reviews"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "x18n",
      "properties": {
        "x18n.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Run the x18n language server in this workspace."
        },
        "x18n.useLocalServer": {
          "type": "boolean",
          "default": true,
          "description": "Run the `@x18n/lsp` installed in the workspace's `node_modules` instead of the bundled server, when there is one. Restart the server after changing this."
        },
        "x18n.annotations": {
          "type": "boolean",
          "default": true,
          "description": "Show translated values next to or in place of keys in code."
        },
        "x18n.annotationInPlace": {
          "type": "boolean",
          "default": true,
          "description": "Replace keys in code with their display-locale value. The raw key shows on the cursor line and inside selections."
        },
        "x18n.annotationInPlaceFullMatch": {
          "type": "boolean",
          "default": false,
          "description": "In in-place mode, replace the whole translate call, such as `t('key', { n })`, instead of only the key. Keys whose call is not known keep the key-only replacement."
        },
        "x18n.annotationMaxLength": {
          "type": "number",
          "default": 40,
          "description": "Longest value shown in an annotation. Longer values are truncated, and in-place mode falls back to an after-key hint."
        },
        "x18n.displayLocale": {
          "type": "string",
          "default": "",
          "description": "Locale shown in annotations. Empty means the source locale."
        },
        "x18n.showFlags": {
          "type": "boolean",
          "default": true,
          "description": "Show the flag of each locale in views, pickers, hovers and the status bar."
        },
        "x18n.theme.annotation": {
          "type": "string",
          "default": "",
          "description": "CSS color of in-place values. Empty uses the inlay hint color of the theme."
        },
        "x18n.theme.annotationMissing": {
          "type": "string",
          "default": "",
          "description": "CSS color of keys without a value. Empty uses the warning color of the theme."
        },
        "x18n.theme.annotationBorder": {
          "type": "string",
          "default": "",
          "description": "CSS border color of in-place values. Empty draws no border."
        },
        "x18n.theme.annotationMissingBorder": {
          "type": "string",
          "default": "",
          "description": "CSS border color of keys without a value. Empty draws no border."
        },
        "x18n.theme.annotationInPlaceFullMatch": {
          "type": "string",
          "default": "",
          "description": "CSS color of values that replace a whole call (`x18n.annotationInPlaceFullMatch`). Empty uses `x18n.theme.annotation`."
        },
        "x18n.codeLens": {
          "type": "boolean",
          "default": false,
          "description": "Show usage counts and missing locales above keys in resource files."
        },
        "x18n.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace the communication between VS Code and the x18n language server."
        }
      }
    },
    "jsonValidation": [
      {
        "fileMatch": "x18n.config.json",
        "url": "https://x18n.antfu.dev/schema/config.json"
      }
    ],
    "yamlValidation": [
      {
        "fileMatch": [
          "x18n.config.yml",
          "x18n.config.yaml"
        ],
        "url": "https://x18n.antfu.dev/schema/config.json"
      },
      {
        "fileMatch": [
          "*.x18n-plugin.yml",
          "*.x18n-plugin.yaml"
        ],
        "url": "https://x18n.antfu.dev/schema/plugin.json"
      }
    ]
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch --sourcemap",
    "codegen": "vscode-ext-gen --scope x18n --output src/generated/meta.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:e2e": "pnpm run build && tsx test/e2e/run.ts",
    "ext:package": "pnpm run build && tsx scripts/stage.ts && cd .vsce && vsce package --no-dependencies -o ../x18n.vsix",
    "ext:publish": "pnpm run ext:package && vsce publish --packagePath x18n.vsix && ovsx publish x18n.vsix"
  },
  "devDependencies": {
    "@iconify-json/circle-flags": "catalog:frontend",
    "@oxc-parser/binding-wasm32-wasip1": "catalog:deps",
    "@types/vscode": "catalog:types",
    "@vscode/test-electron": "catalog:vscode",
    "@vscode/vsce": "catalog:vscode",
    "@x18n/lsp": "workspace:*",
    "ovsx": "catalog:vscode",
    "reactive-vscode": "catalog:vscode",
    "tsx": "catalog:cli",
    "vscode-ext-gen": "catalog:vscode",
    "vscode-languageclient": "catalog:vscode",
    "vscode-languageserver": "catalog:deps",
    "vsxpub": "catalog:vscode"
  }
}
